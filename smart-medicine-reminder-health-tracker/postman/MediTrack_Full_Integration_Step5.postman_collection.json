{
  "info": {
    "_postman_id": "a98e1234-bcde-4321-9876-meditrackstep5",
    "name": "MediTrack - Step 5 Complete Integration Test Suite",
    "description": "Comprehensive Postman test collection covering all Smart Medicine Reminder & Health Tracker REST API endpoints: Health Check, Authentication, Profile, Medicine CRUD, Daily Tracking, Adherence Progress, History Filtering (by date range, status, medicine), Cross-User Data Isolation, and Error Handling.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userBToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "medicineId",
      "value": "",
      "type": "string"
    },
    {
      "key": "recordId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. System Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Health status is ok', function () { const json = pm.response.json(); pm.expect(json.success).to.be.true; });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Authentication & Profile",
      "item": [
        {
          "name": "Register User A",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Step5 Tester\",\n  \"email\": \"alice.step5@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) { pm.collectionVariables.set('authToken', json.data.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login User A",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice.step5@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.expect(json.data.user.email).to.eql('alice.step5@example.com');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get User A Profile (Protected)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.expect(json.data.user.passwordHash).to.be.undefined;"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Reject Unauthorized Request Without Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 401', function () { pm.response.to.have.status(401); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Medicine Management (CRUD)",
      "item": [
        {
          "name": "Create Medicine 1 (Twice daily)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Amoxicillin 500mg\",\n  \"dosage\": \"1 capsule\",\n  \"frequency\": \"Twice daily\",\n  \"reminderTimes\": [\"08:00\", \"20:00\"],\n  \"startDate\": \"2026-10-01\",\n  \"endDate\": \"2026-12-31\",\n  \"instructions\": \"Take after breakfast and dinner with a glass of water\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/medicines", "host": ["{{baseUrl}}"], "path": ["medicines"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "if (json.data && json.data.id) { pm.collectionVariables.set('medicineId', json.data.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Create Medicine 2 (Once daily)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Vitamin D3\",\n  \"dosage\": \"1000 IU\",\n  \"frequency\": \"Once daily\",\n  \"reminderTimes\": [\"09:00\"],\n  \"startDate\": \"2026-10-01\",\n  \"instructions\": \"Take with morning meal\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/medicines", "host": ["{{baseUrl}}"], "path": ["medicines"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Reject Invalid Reminder Time (25:99)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Invalid Time Med\",\n  \"dosage\": \"1 tablet\",\n  \"frequency\": \"Daily\",\n  \"reminderTimes\": [\"25:99\"],\n  \"startDate\": \"2026-10-01\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/medicines", "host": ["{{baseUrl}}"], "path": ["medicines"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400', function () { pm.response.to.have.status(400); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "List Medicines",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/medicines", "host": ["{{baseUrl}}"], "path": ["medicines"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.expect(json.data.length).to.be.at.least(2);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Medicine by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/medicines/{{medicineId}}", "host": ["{{baseUrl}}"], "path": ["medicines", "{{medicineId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Update Medicine",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dosage\": \"2 capsules\",\n  \"instructions\": \"Take with whole glass of water\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/medicines/{{medicineId}}", "host": ["{{baseUrl}}"], "path": ["medicines", "{{medicineId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.expect(json.data.dosage).to.eql('2 capsules');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Daily Medication Tracking & Status",
      "item": [
        {
          "name": "Get Today Schedule & Adherence Summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/records/today", "host": ["{{baseUrl}}"], "path": ["records", "today"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.expect(json.data.summary).to.have.property('adherenceRate');",
                  "if (json.data.records && json.data.records.length > 0) { pm.collectionVariables.set('recordId', json.data.records[0].id); }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Mark Dose as Taken",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Taken\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/records/{{recordId}}/status", "host": ["{{baseUrl}}"], "path": ["records", "{{recordId}}", "status"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.expect(json.data.status).to.eql('Taken');",
                  "pm.expect(json.data.takenAt).to.not.be.null;"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Mark Dose as Missed",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Missed\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/records/{{recordId}}/status", "host": ["{{baseUrl}}"], "path": ["records", "{{recordId}}", "status"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.expect(json.data.status).to.eql('Missed');",
                  "pm.expect(json.data.takenAt).to.be.null;"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Reset Dose to Pending",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Pending\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/records/{{recordId}}/status", "host": ["{{baseUrl}}"], "path": ["records", "{{recordId}}", "status"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.expect(json.data.status).to.eql('Pending');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Reject Invalid Status Value",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Skipped\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/records/{{recordId}}/status", "host": ["{{baseUrl}}"], "path": ["records", "{{recordId}}", "status"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400', function () { pm.response.to.have.status(400); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. Medication History & Filters",
      "item": [
        {
          "name": "Get All Medication History",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/records/history", "host": ["{{baseUrl}}"], "path": ["records", "history"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.expect(Array.isArray(json.data)).to.be.true;"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Filter History by Status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/records/history?status=Taken", "host": ["{{baseUrl}}"], "path": ["records", "history"], "query": [{ "key": "status", "value": "Taken" }] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Filter History by Medicine",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/records/history?medicineId={{medicineId}}", "host": ["{{baseUrl}}"], "path": ["records", "history"], "query": [{ "key": "medicineId", "value": "{{medicineId}}" }] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Filter History by Date Range",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/records/history?startDate=2026-10-01&endDate=2026-12-31", "host": ["{{baseUrl}}"], "path": ["records", "history"], "query": [{ "key": "startDate", "value": "2026-10-01" }, { "key": "endDate", "value": "2026-12-31" }] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Reject Invalid Date Range (startDate > endDate)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/records/history?startDate=2026-12-31&endDate=2026-01-01", "host": ["{{baseUrl}}"], "path": ["records", "history"], "query": [{ "key": "startDate", "value": "2026-12-31" }, { "key": "endDate", "value": "2026-01-01" }] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400', function () { pm.response.to.have.status(400); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "6. Cross-User Data Isolation",
      "item": [
        {
          "name": "Register User B",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bob Step5 Attacker\",\n  \"email\": \"bob.step5@example.com\",\n  \"password\": \"AttackerPass123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) { pm.collectionVariables.set('userBToken', json.data.token); }"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "User B Cannot Read User A Medicine (404)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userBToken}}" }],
            "url": { "raw": "{{baseUrl}}/medicines/{{medicineId}}", "host": ["{{baseUrl}}"], "path": ["medicines", "{{medicineId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 404', function () { pm.response.to.have.status(404); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "User B Cannot Modify User A Dose Record (404)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{userBToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"Taken\"\n}" },
            "url": { "raw": "{{baseUrl}}/records/{{recordId}}/status", "host": ["{{baseUrl}}"], "path": ["records", "{{recordId}}", "status"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 404', function () { pm.response.to.have.status(404); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "7. Medicine Deletion",
      "item": [
        {
          "name": "Delete Medicine as Owner (User A)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
            "url": { "raw": "{{baseUrl}}/medicines/{{medicineId}}", "host": ["{{baseUrl}}"], "path": ["medicines", "{{medicineId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
