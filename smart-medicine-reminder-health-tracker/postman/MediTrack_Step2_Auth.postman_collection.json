{
  "info": {
    "name": "MediTrack - Step 2 Auth & Protected Routes",
    "_postman_id": "c1f7b8a2-9b22-4917-a00e-6f81c96412e1",
    "description": "Comprehensive Postman test collection for Smart Medicine Reminder & Health Tracker Step 2: User Registration, Login, JWT Authentication, and Protected Routes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "health"]
        },
        "description": "Confirms the Express backend is running and operational."
      }
    },
    {
      "name": "02. Register - Valid New User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Response has success true\", function () {",
              "    pm.expect(jsonData.success).to.eql(true);",
              "});",
              "pm.test(\"User does NOT expose passwordHash\", function () {",
              "    pm.expect(jsonData.data.user.passwordHash).to.be.undefined;",
              "});",
              "if (jsonData.data && jsonData.data.token) {",
              "    pm.collectionVariables.set(\"authToken\", jsonData.data.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Vijayapandian T\",\n  \"email\": \"vijay@example.com\",\n  \"password\": \"SecurePass123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "register"]
        },
        "description": "Registers a new user and returns a sanitized user profile and JWT."
      }
    },
    {
      "name": "03. Register - Duplicate Email (Expects 409)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 409 Conflict\", function () {",
              "    pm.response.to.have.status(409);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Success is false\", function () {",
              "    pm.expect(jsonData.success).to.eql(false);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Vijayapandian Duplicate\",\n  \"email\": \"vijay@example.com\",\n  \"password\": \"AnotherPass123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "register"]
        },
        "description": "Rejects duplicate email registrations with HTTP 409."
      }
    },
    {
      "name": "04. Register - Invalid Input (Short Password) (Expects 400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400 Bad Request\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Returns validation error message\", function () {",
              "    pm.expect(jsonData.success).to.eql(false);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Short Pass User\",\n  \"email\": \"short@example.com\",\n  \"password\": \"123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "register"]
        },
        "description": "Rejects registrations with short password (< 6 chars) with HTTP 400."
      }
    },
    {
      "name": "05. Login - Valid Credentials",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Returns signed JWT\", function () {",
              "    pm.expect(jsonData.data.token).to.be.a('string');",
              "});",
              "pm.test(\"Does not return passwordHash\", function () {",
              "    pm.expect(jsonData.data.user.passwordHash).to.be.undefined;",
              "});",
              "if (jsonData.data && jsonData.data.token) {",
              "    pm.collectionVariables.set(\"authToken\", jsonData.data.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"vijay@example.com\",\n  \"password\": \"SecurePass123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        },
        "description": "Authenticates user credentials and captures JWT into collection variable."
      }
    },
    {
      "name": "06. Login - Invalid Credentials (Expects 401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 401 Unauthorized\", function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Generic authentication error message\", function () {",
              "    pm.expect(jsonData.message).to.eql(\"Invalid email or password.\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"vijay@example.com\",\n  \"password\": \"WrongPassword!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "login"]
        },
        "description": "Rejects incorrect password with generic 401 error."
      }
    },
    {
      "name": "07. Protected Profile - Valid Bearer Token (GET /api/auth/me)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"User profile retrieved\", function () {",
              "    pm.expect(jsonData.data.user.email).to.eql(\"vijay@example.com\");",
              "});",
              "pm.test(\"Password hash is omitted\", function () {",
              "    pm.expect(jsonData.data.user.passwordHash).to.be.undefined;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{authToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/me",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "me"]
        },
        "description": "Retrieves the authenticated user profile using a valid JWT in the Authorization header."
      }
    },
    {
      "name": "08. Protected Profile - Missing Token (Expects 401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 401 Unauthorized\", function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Access denied message\", function () {",
              "    pm.expect(jsonData.success).to.eql(false);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/me",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "me"]
        },
        "description": "Verifies that omitting the Authorization header returns 401."
      }
    },
    {
      "name": "09. Protected Profile - Invalid Token (Expects 401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 401 Unauthorized\", function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Invalid token rejected\", function () {",
              "    pm.expect(jsonData.success).to.eql(false);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.invalidTokenSignature.FakeSig",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/auth/me",
          "host": ["{{baseUrl}}"],
          "path": ["api", "auth", "me"]
        },
        "description": "Verifies that an invalid, tampered, or expired JWT returns 401."
      }
    }
  ]
}
